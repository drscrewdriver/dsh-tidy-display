{
  "name": "dsh-tidy-display",
  "version": "0.2.3-beta.1",
  "description": "One plugin for a calmer DeepSeek Harness: reading view + message rail + smart history loading, for the Harness 0.2.0 line.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "dsh-0.2.0"
  },
  "main": "lib/dsh-tidy-display.js",
  "types": "lib/types/dsh-tidy-display.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/dsh-tidy-display.d.ts",
      "default": "./lib/dsh-tidy-display.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/check-harness-compat.mjs && tsc -p tsconfig.json && tsdown",
    "check:harness": "node scripts/check-harness-compat.mjs",
    "test:official": "node scripts/verify-official-bridge.mjs",
    "test:auto-fold": "node scripts/verify-auto-fold.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "link:harness": "node scripts/link-harness-dependencies.mjs",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-util-workspace-path": ">=0.2.0-rc.1 <0.2.1-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-turn-outline": "0.2.0-rc.2",
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2"
  },
  "files": [
    "lib",
    "skills",
    "src",
    "tests",
    "scripts",
    "cordis.yml",
    "cordis.patch.yml",
    "dshx.yml",
    "tsconfig.json",
    "tsdown.config.ts",
    "README.md",
    "README.en.md",
    "DESIGN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "compat",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-tidy-display.git"
  },
  "homepage": "https://github.com/drscrewdriver/dsh-tidy-display#readme",
  "bugs": {
    "url": "https://github.com/drscrewdriver/dsh-tidy-display/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dshx",
    "conversation",
    "reasoning",
    "streaming",
    "accessibility"
  ]
}
