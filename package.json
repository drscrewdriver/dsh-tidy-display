{
  "name": "@drscrewdriver/dsh-tidy-display",
  "version": "0.1.0",
  "description": "Message-rail subset of tidy-display for legacy DeepSeek Harness (0.1.0-rc.7 ~ 0.1.2-alpha.1): canvas rail, theme-aware palette, smart history loading.",
  "type": "module",
  "license": "MIT",
  "main": "lib/dsh-tidy-display.js",
  "types": "lib/types/dsh-tidy-display.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/dsh-tidy-display.d.ts",
      "default": "./lib/dsh-tidy-display.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7 <0.1.2-alpha.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "immer": "^10.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "zustand": "~4.4.7"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "files": [
    "lib",
    "src",
    "tests",
    "cordis.patch.yml",
    "tsconfig.json",
    "tsdown.config.ts",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-tidy-display.git"
  },
  "homepage": "https://github.com/drscrewdriver/dsh-tidy-display#readme",
  "bugs": {
    "url": "https://github.com/drscrewdriver/dsh-tidy-display/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dshx",
    "message-rail",
    "navigation",
    "legacy"
  ]
}
